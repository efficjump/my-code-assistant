{
  "name": "my-code-assistant",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A secure, provider-configurable desktop code assistant.",
  "author": "Code Assistant Contributors",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "pnpm typecheck && electron-vite build",
    "package": "pnpm build && node scripts/package.mjs",
    "signing:setup:mac": "node scripts/setup-local-macos-signing.mjs",
    "signing:verify:mac": "node scripts/verify-macos-signing.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm license:check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test --config=playwright.e2e.config.ts",
    "test:live:responses": "vitest run --config=vitest.live.config.ts tests/live/responses-api-driver.live.test.ts",
    "test:watch": "vitest",
    "license:check": "node scripts/check-licenses.mjs",
    "docs:screenshot": "pnpm build && node scripts/capture-readme.mjs"
  },
  "dependencies": {
    "lucide-react": "1.24.0",
    "openai": "6.46.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@playwright/test": "1.61.1",
    "@swc/core": "1.15.43",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.1.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "com.local.codeassistant",
    "productName": "Code Assistant",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false,
      "resetAdHocDarwinSignature": true
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "forceCodeSigning": true,
      "target": "dir"
    },
    "win": {
      "target": "portable"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "icon": "build/icon.png"
    }
  },
  "packageManager": "pnpm@11.7.0"
}
